# URL pública da API Next (ACME HUB cloud). Sem barra no final.
EXPO_PUBLIC_API_BASE_URL=https://acmehub.com.br

# --- AdMob (producao) — definir no EAS Secrets / env do profile production ---
# Sem estes valores o build usa IDs de teste Google (ok para debug, nao para loja).
# ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXX~YYYYYYYYYY
# ADMOB_APP_OPEN_UNIT_ID=ca-app-pub-XXXXXXXX/ZZZZZZZZZZ
# ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-XXXXXXXX/WWWWWWWWWW
# ADMOB_IOS_APP_ID=  # opcional (app e Android-first)
