{
  "expo": {
    "name": "ACME HUB",
    "slug": "acme-hub",
    "version": "1.15",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "acmehub",
    "platforms": [
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000814"
    },
    "android": {
      "package": "br.cefethub.acme",
      "versionCode": 15,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000814",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#000814",
      "barStyle": "light-content"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-screen-orientation",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#e9b949",
          "defaultChannel": "acme-hub-default",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2654315891415442~4498576769",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://acmehub.com.br",
      "eas": {
        "projectId": "9e0eaddd-a802-465e-8474-cfd6ae69d75d"
      },
      "admobEnabled": true,
      "admobAppOpenUnitId": "ca-app-pub-2654315891415442/5148568599",
      "admobInterstitialUnitId": "ca-app-pub-2654315891415442/2377091712"
    },
    "owner": "kairohfm"
  }
}
