# Copie para `.env.local` na pasta `app/`.

# Chave para cifrar senha SIGAA opcional no SQLite (mín. 16 caracteres).
CREDENTIALS_ENCRYPTION_KEY=

# Playwright: login real no SIGAA (false = desliga mock).
# SIGAA_SCRAPER_MOCK=false

# Timeouts do scraper (ms).
# SIGAA_LOGIN_TIMEOUT_MS=30000
# SIGAA_NAVIGATION_TIMEOUT_MS=20000

# SIGAA_HEADLESS=false

# --- Worker Playwright — PATH OFICIAL: Servidor ACME (PC ou Termux) ---
# Cloudflare só despacha; Chrome/Chromium + sync + mirror rodam no worker.
# Ver README.md §8 · npm run worker:home · scripts/termux-servidor-acme.sh
# WORKER_PORT=8787
# WORKER_SHARED_SECRET=  # mín. 16 chars; Bearer em POST /jobs (mesmo no CF)
# SIGAA_WORKER_MAX_CONCURRENT=1
# SIGAA_WORKER_JOB_TIMEOUT_MS=480000
# SIGAA_WORKER_SHUTDOWN_MS=600000
# PLANNER_DATA_ROOT=.data
# SIGAA_BROWSER_CHANNEL=chrome  # Chrome do Windows; omitir = Chromium Playwright

# --- Fila sync (B55) — SQLite global na API Next.js (dev local) ---
# SYNC_QUEUE_DB_PATH=.data/sync-queue.db
# SIGAA_WORKER_URL=http://127.0.0.1:8787
# SYNC_QUEUE_DISPATCH=inline

# --- Mirror sync → Postgres (B72) + PC via cloudflared (B72e) ---
# No worker (PC): SYNC_MIRROR_POSTGRES=true + DATABASE_URL +
# CREDENTIALS_ENCRYPTION_KEY (mesma chave do app cloud) + WORKER_SHARED_SECRET.
# No app cloud (secrets wrangler): SIGAA_WORKER_URL=https://….trycloudflare.com
# (ou hostname do túnel nomeado) + WORKER_SHARED_SECRET (mesmo valor).
# SYNC_MIRROR_POSTGRES=true

# --- Cooldowns sync (O3) ---
# SYNC_COOLDOWN_PROFILE=production
# SYNC_AUTO_INTERVAL_MINUTES=180

# Dev: parsear PDF local do histórico (pula navegação SIGAA na etapa B30)
# SIGAA_HISTORICO_PDF_PATH=../docs/referencias/historico_00000000000.pdf

# --- Supabase — Auth + Postgres (produção) ---
# PLANNER_DATABASE=sqlite
# PLANNER_DATABASE=postgres
# PLANNER_CURSO_ID=eng-computacao
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # só server; nunca expor no client
# DATABASE_URL=  # URI completa — npm run db:migrate; não commitar
# Windows/IPv4: Connect → Session pooler → postgresql://postgres.REF:SENHA@aws-1-REGION.pooler.supabase.com:5432/postgres
# Direct (db.REF.supabase.co) costuma ser só IPv6 — pode dar getaddrinfo ENOENT no Windows

# --- Cloudflare deploy — ver README.md §9 ---
# PLANNER_CLOUD=true  # obrigatório em Workers (desliga SQLite planner.db)
# CRON_SECRET=  # protege health deep + POST /api/cron/* (Bearer ou x-cron-secret)
# PLANNER_HEALTH_URL=  # worker cron-ping: URL pública do app (ex. https://acmehub.com.br)
# PLANNER_APP_URL=  # cron-account-emails + cron-app-update-notify; se vazio, usa PLANNER_HEALTH_URL

# --- Avisos internos de suporte (cadastro + pagamento aprovado) ---
# SUPPORT_NOTIFY_EMAIL=acme.hubsuporte@gmail.com

# --- Provedor de e-mail transacional (B62b / home-gmail) ---
# Prioridade: home-gmail (PC) → Brevo → Resend → stub.
#
# Entrega real no Gmail (recomendado enquanto não há domínio):
# Cloud (secret): ACCOUNT_EMAIL_VIA_HOME_WORKER=true
#                 (+ SIGAA_WORKER_URL + WORKER_SHARED_SECRET já usados no sync)
# PC (.env.local do worker):
# GMAIL_SMTP_USER=seu@gmail.com
# GMAIL_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx   # senha de app (Conta Google → Segurança)
# EMAIL_FROM=ACME HUB <seu@gmail.com>
#
# Brevo (grátis 300/dia — Gmail costuma engolir *.brevosend.com):
# BREVO_API_KEY=             # xkeysib-... (secret; nunca commitar)
# EMAIL_FROM=ACME HUB <remetente-verificado@gmail.com>
# EMAIL_REPLY_TO=            # opcional — endereço de resposta
#
# Resend (alternativa — exige DOMÍNIO verificado):
# RESEND_API_KEY=           # re_... (secret; nunca commitar)
# EMAIL_FROM=ACME HUB <no-reply@seu-dominio.com>

# --- Painel /dev — operadores autorizados (NUNCA commitar valores reais) ---
# Login sempre pede email + senha; validação server-side contra estes pares.
# Novo dev no futuro: adicionar MANUALMENTE no env (comentado até usar) — sem UI/cadastro no app.
#
# 1º operador (local):
# EMAIL_DEV=
# PASSWORD_DEV=
#
# Operadores adicionais (descomente e preencha quando precisar):
# PLANNER_DEV_2_EMAIL=
# PLANNER_DEV_2_PASSWORD=
# PLANNER_DEV_3_EMAIL=
# PLANNER_DEV_3_PASSWORD=
#
# Sessão operador (cookie httpOnly); fallback: CRON_SECRET ou CREDENTIALS_ENCRYPTION_KEY
# PLANNER_DEV_SESSION_SECRET=

# --- Billing / planos (B47) — preços em centavos BRL; omitir = defaults ---
# BILLING_PRICE_MONTH_CENTS=3000
# BILLING_PRICE_QUARTER_CENTS=5000
# BILLING_PRICE_SEMESTER_CENTS=8500
# BILLING_PRICE_YEAR_CENTS=15000
# BILLING_PRICE_FIVE_YEAR_CENTS=70000

# --- Gateway PIX (B48) — ver docs/plan/b48-pix-gateway.md ---
# PIX_GATEWAY=mock
# PIX_GATEWAY=mercadopago
# MERCADOPAGO_ACCESS_TOKEN=  # TEST-... = sandbox
# MERCADOPAGO_WEBHOOK_SECRET=  # B51 webhook
# PLANNER_PIX_MOCK_CHECKOUT=true  # mock: libera checkout simulado (B50)
# PIX_GATEWAY=asaas
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox

# Ads web (AdSense) — opcional; sem isso a UI mostra placeholder
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# --- Google Play Billing (Android — remocao de anuncios) ---
# Package do app (deve bater com mobile/app.json → android.package)
# GOOGLE_PLAY_PACKAGE_NAME=br.cefethub.acme
# JSON da service account (Android Publisher API) — secret no Cloudflare Workers
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# So em dev local (NUNCA em producao): aceita verify sem service account
# PLAY_BILLING_DEV_ACCEPT=1
# SKUs no Play Console (subscriptions): ads_free_month | ads_free_year
