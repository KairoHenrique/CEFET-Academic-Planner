# Copie para `.env.local` na pasta `app/`.

# Chave para cifrar senha SIGAA opcional no SQLite (mín. 16 caracteres).
CREDENTIALS_ENCRYPTION_KEY=

# Playwright: login real no SIGAA (false = desliga mock).
# SIGAA_SCRAPER_MOCK=false

# Timeouts do scraper (ms).
# SIGAA_LOGIN_TIMEOUT_MS=30000
# SIGAA_NAVIGATION_TIMEOUT_MS=20000

# SIGAA_HEADLESS=false

# --- Worker Playwright (B54) — processo separado do Next.js ---
# WORKER_PORT=8787
# WORKER_SHARED_SECRET=  # mín. 16 chars; Bearer em POST /jobs
# SIGAA_WORKER_MAX_CONCURRENT=1
# SIGAA_WORKER_JOB_TIMEOUT_MS=480000
# SIGAA_WORKER_SHUTDOWN_MS=600000
# PLANNER_DATA_ROOT=.data

# --- Fila sync (B55) — SQLite global na API Next.js ---
# SYNC_QUEUE_DB_PATH=.data/sync-queue.db
# SIGAA_WORKER_URL=http://127.0.0.1:8787
# SYNC_QUEUE_DISPATCH=inline

# --- Cooldowns sync (O3) ---
# SYNC_COOLDOWN_PROFILE=production
# SYNC_AUTO_INTERVAL_MINUTES=180

# Dev: parsear PDF local do histórico (pula navegação SIGAA na etapa B30)
# SIGAA_HISTORICO_PDF_PATH=../docs/referencias/historico_20243003554.pdf

# --- Supabase (Bloco 6a) — ver docs/plan/6a-supabase-plan.md ---
# PLANNER_DATABASE=sqlite
# PLANNER_DATABASE=postgres
# PLANNER_CURSO_ID=eng-computacao
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # só server; nunca expor no client
# DATABASE_URL=  # URI completa — migrations B39; não commitar
# Windows/IPv4: Connect → Session pooler → postgresql://postgres.REF:SENHA@aws-1-REGION.pooler.supabase.com:5432/postgres
# Direct (db.REF.supabase.co) costuma ser só IPv6 — pode dar getaddrinfo ENOENT no Windows

# --- Cloudflare deploy (O1) — ver docs/plan/o1-cloudflare-deploy.md ---
# PLANNER_CLOUD=true  # obrigatório em Workers (O2: desliga SQLite planner.db)
# CRON_SECRET=  # protege GET /api/health?deep=1 e POST /api/cron/account-emails (Bearer ou x-cron-secret)
# PLANNER_HEALTH_URL=  # worker cron-ping: URL pública do app (ex. https://acme-hub.x.workers.dev)
# PLANNER_APP_URL=  # worker cron-account-emails (B62); se vazio, deploy:crons usa PLANNER_HEALTH_URL

# --- Painel /dev — operadores autorizados (NUNCA commitar valores reais) ---
# Login sempre pede email + senha; validação server-side contra estes pares.
# Novo dev no futuro: adicionar MANUALMENTE no env (comentado até usar) — sem UI/cadastro no app.
#
# 1º operador (local):
# EMAIL_DEV=
# PASSWORD_DEV=
#
# Operadores adicionais (descomente e preencha quando precisar):
# PLANNER_DEV_2_EMAIL=
# PLANNER_DEV_2_PASSWORD=
# PLANNER_DEV_3_EMAIL=
# PLANNER_DEV_3_PASSWORD=
#
# Sessão operador (cookie httpOnly); fallback: CRON_SECRET ou CREDENTIALS_ENCRYPTION_KEY
# PLANNER_DEV_SESSION_SECRET=

# --- Billing / planos (B47) — preços em centavos BRL; omitir = defaults ---
# BILLING_PRICE_MONTH_CENTS=3000
# BILLING_PRICE_QUARTER_CENTS=5000
# BILLING_PRICE_SEMESTER_CENTS=8500
# BILLING_PRICE_YEAR_CENTS=15000
# BILLING_PRICE_FIVE_YEAR_CENTS=70000

# --- Gateway PIX (B48) — ver docs/plan/b48-pix-gateway.md ---
# PIX_GATEWAY=mock
# PIX_GATEWAY=mercadopago
# MERCADOPAGO_ACCESS_TOKEN=  # TEST-... = sandbox
# MERCADOPAGO_WEBHOOK_SECRET=  # B51 webhook
# PLANNER_PIX_MOCK_CHECKOUT=true  # mock: libera checkout simulado (B50)
# PIX_GATEWAY=asaas
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
