# Copie para `.env.local` na pasta `app/`.

# Chave para cifrar senha SIGAA opcional no SQLite (mín. 16 caracteres).
CREDENTIALS_ENCRYPTION_KEY=

# Playwright: login real no SIGAA (false = desliga mock).
# SIGAA_SCRAPER_MOCK=false

# Timeouts do scraper (ms).
# SIGAA_LOGIN_TIMEOUT_MS=30000
# SIGAA_NAVIGATION_TIMEOUT_MS=20000

# SIGAA_HEADLESS=false

# Dev: parsear PDF local do histórico (pula navegação SIGAA na etapa B30)
# SIGAA_HISTORICO_PDF_PATH=../docs/referencias/historico_20243003554.pdf
