{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acme-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "acme-hub"
    }
  ],
  "vars": {
    "PLANNER_DATABASE": "postgres",
    "NEXT_PUBLIC_SUPABASE_URL": "https://xxtdifoltfipaerexosq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_JQbX4rMPN7fpzseXvKkiSA_sYJbqytw",
    "PLANNER_CLOUD": "true",
    "PLANNER_CURSO_ID": "eng-computacao"
  }
}
